{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HaydenKaufmann/clipbridge-extensions/extension.schema.json",
  "title": "ClipBridge extension",
  "description": "An app for the ClipBridge home screen: a page and widgets made of the app's blocks. See docs/extensions.md.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$",
      "description": "Unique, lower case; also the app and page id."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+){0,3}$"
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "One line for the store list."
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "category": {
      "enum": [
        "productivity",
        "media",
        "developer",
        "presentation",
        "utilities"
      ]
    },
    "icon": {
      "enum": [
        "blank",
        "bolt",
        "bookmark",
        "chat",
        "clipboard",
        "code",
        "command",
        "copy",
        "deck",
        "dongle",
        "download",
        "duck",
        "edit",
        "gear",
        "history",
        "home",
        "keyboard",
        "library",
        "link",
        "lock",
        "macro",
        "mail",
        "mouse",
        "mute",
        "page",
        "paste",
        "pause",
        "play",
        "pointer",
        "redo",
        "remote",
        "screenshot",
        "search",
        "send",
        "settings",
        "skip_next",
        "skip_previous",
        "slides",
        "slideshow",
        "star",
        "store",
        "terminal",
        "text",
        "trackpad",
        "undo",
        "volume_down",
        "volume_up",
        "window"
      ],
      "description": "A pixel icon or a page icon."
    },
    "accent": {
      "enum": [
        "primary",
        "secondary",
        "tertiary",
        "error",
        "neutral"
      ]
    },
    "permissions": {
      "type": "array",
      "items": {
        "enum": [
          "typeText",
          "pressKeys",
          "mouse",
          "runDucky",
          "readClipboard",
          "runScript",
          "runCommands"
        ]
      }
    },
    "changelog": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "notes": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "version",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "page": {
      "$ref": "#/$defs/page"
    },
    "widgets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/widget"
      },
      "maxItems": 8
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "A command the app can run on the computer, approved at install.",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "run": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "The exact command, run in the computer's shell. {name} placeholders are filled (quoted) from the script's cb.run arguments."
          },
          "cwd": {
            "type": "string",
            "maxLength": 300,
            "description": "Where it starts, e.g. ~/code/web."
          },
          "timeout": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          }
        },
        "required": [
          "id",
          "title",
          "run"
        ],
        "additionalProperties": false
      },
      "maxItems": 32
    },
    "script": {
      "type": "string",
      "maxLength": 65536,
      "description": "JavaScript run in a sandbox when a \"script\" button is tapped; see docs/extensions.md for the cb API."
    }
  },
  "required": [
    "id",
    "name",
    "version",
    "author",
    "summary",
    "page"
  ],
  "additionalProperties": false,
  "$defs": {
    "page": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "heading": {
          "type": "string",
          "maxLength": 32
        },
        "icon": {
          "enum": [
            "bolt",
            "clipboard",
            "code",
            "command",
            "copy",
            "download",
            "edit",
            "home",
            "keyboard",
            "library",
            "link",
            "lock",
            "macro",
            "mail",
            "mouse",
            "mute",
            "page",
            "paste",
            "pause",
            "play",
            "redo",
            "remote",
            "screenshot",
            "search",
            "send",
            "settings",
            "skip_next",
            "skip_previous",
            "slideshow",
            "star",
            "terminal",
            "text",
            "trackpad",
            "undo",
            "volume_down",
            "volume_up",
            "window"
          ]
        },
        "header": {
          "type": "boolean"
        },
        "mark": {
          "type": "boolean"
        },
        "background": {
          "enum": [
            "plain",
            "grid"
          ]
        },
        "accent": {
          "enum": [
            "primary",
            "secondary",
            "tertiary",
            "error",
            "neutral"
          ]
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          },
          "maxItems": 4
        },
        "tabs": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "A page within the app, shown as a tab under the header. Each section names the tab it is on with \"tab\".",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,40}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16
              },
              "icon": {
                "enum": [
                  "bolt",
                  "clipboard",
                  "code",
                  "command",
                  "copy",
                  "download",
                  "edit",
                  "home",
                  "keyboard",
                  "library",
                  "link",
                  "lock",
                  "macro",
                  "mail",
                  "mouse",
                  "mute",
                  "page",
                  "paste",
                  "pause",
                  "play",
                  "redo",
                  "remote",
                  "screenshot",
                  "search",
                  "send",
                  "settings",
                  "skip_next",
                  "skip_previous",
                  "slideshow",
                  "star",
                  "terminal",
                  "text",
                  "trackpad",
                  "undo",
                  "volume_down",
                  "volume_up",
                  "window"
                ]
              }
            },
            "required": [
              "id",
              "title"
            ],
            "additionalProperties": false
          },
          "maxItems": 8
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          },
          "maxItems": 32
        }
      },
      "required": [
        "title",
        "sections"
      ],
      "additionalProperties": false
    },
    "section": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,40}$"
            },
            "tab": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,40}$"
            },
            "type": {
              "const": "grid"
            },
            "dock": {
              "type": "boolean"
            },
            "blocks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/block"
              },
              "maxItems": 24
            }
          },
          "required": [
            "id",
            "type",
            "blocks"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,40}$"
            },
            "tab": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,40}$"
            },
            "type": {
              "const": "fill"
            },
            "flex": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "block": {
              "$ref": "#/$defs/block"
            }
          },
          "required": [
            "id",
            "type",
            "block"
          ],
          "additionalProperties": false
        }
      ]
    },
    "block": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,40}$"
        },
        "module": {
          "enum": [
            "action_button",
            "agent_status",
            "compose",
            "connect_notice",
            "fetch_clipboard",
            "help",
            "history_list",
            "history_search",
            "key_bar",
            "keyboard_pad",
            "keyboard_toggle",
            "library_chips",
            "library_import",
            "library_list",
            "library_new",
            "library_search",
            "mouse_buttons",
            "note",
            "output",
            "send_clipboard",
            "status_card",
            "trackpad",
            "transfer_progress"
          ]
        },
        "span": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "settings": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "maxLength": 40,
              "description": "A button's label. Fits in full: 15 characters on a 2-column button, 28 on 3, 40 on 4; 12 on a 1-column 2-row button, 30 on a 2-column 2-row one. A 1-column 1-row button shows only its icon."
            },
            "info": {
              "type": "string",
              "maxLength": 400,
              "description": "A button's explanation, shown when it's held: what it does, when to use it."
            },
            "title": {
              "type": "string",
              "maxLength": 60,
              "description": "A note's heading."
            },
            "text": {
              "type": "string",
              "maxLength": 1000,
              "description": "A note's text."
            },
            "code": {
              "type": "string",
              "maxLength": 500,
              "description": "A command shown in a note; tap to copy."
            },
            "icon": {
              "enum": [
                "bolt",
                "clipboard",
                "code",
                "command",
                "copy",
                "download",
                "edit",
                "home",
                "keyboard",
                "library",
                "link",
                "lock",
                "macro",
                "mail",
                "mouse",
                "mute",
                "page",
                "paste",
                "pause",
                "play",
                "redo",
                "remote",
                "screenshot",
                "search",
                "send",
                "settings",
                "skip_next",
                "skip_previous",
                "slideshow",
                "star",
                "terminal",
                "text",
                "trackpad",
                "undo",
                "volume_down",
                "volume_up",
                "window"
              ]
            },
            "color": {
              "enum": [
                "primary",
                "secondary",
                "tertiary",
                "error",
                "neutral"
              ]
            },
            "filled": {
              "type": "boolean"
            },
            "action": {
              "$ref": "#/$defs/action"
            }
          }
        }
      },
      "required": [
        "id",
        "module"
      ],
      "additionalProperties": false
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "steps"
            },
            "steps": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/step"
              },
              "minItems": 1,
              "maxItems": 64
            }
          },
          "required": [
            "type",
            "steps"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "send_clipboard"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "fetch_clipboard"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "compose"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "script"
            },
            "call": {
              "type": "string",
              "pattern": "^[A-Za-z_$][A-Za-z0-9_$]{0,39}$",
              "description": "A function in the extension's script."
            },
            "args": {
              "type": "array",
              "maxItems": 8,
              "description": "JSON values passed to the function."
            }
          },
          "required": [
            "type",
            "call"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "open_page"
            },
            "page": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "page"
          ],
          "additionalProperties": false
        }
      ]
    },
    "step": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "t": {
              "const": "text"
            },
            "v": {
              "type": "string",
              "maxLength": 4000
            }
          },
          "required": [
            "t",
            "v"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "t": {
              "const": "key"
            },
            "k": {
              "anyOf": [
                {
                  "enum": [
                    "return",
                    "esc",
                    "delete",
                    "tab",
                    "space",
                    "fwd-delete",
                    "left",
                    "right",
                    "up",
                    "down",
                    "home",
                    "end",
                    "page-up",
                    "page-down",
                    "f1",
                    "f2",
                    "f3",
                    "f4",
                    "f5",
                    "f6",
                    "f7",
                    "f8",
                    "f9",
                    "f10",
                    "f11",
                    "f12"
                  ]
                },
                {
                  "type": "string",
                  "pattern": "^[ -~]$",
                  "description": "One printable ASCII character."
                }
              ]
            },
            "m": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15,
              "description": "Modifiers: ctrl 1, shift 2, alt 4, cmd/win 8."
            }
          },
          "required": [
            "t",
            "k"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "t": {
              "const": "wait"
            },
            "ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          },
          "required": [
            "t",
            "ms"
          ],
          "additionalProperties": false
        }
      ]
    },
    "widget": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,40}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "description": {
          "type": "string",
          "maxLength": 200
        },
        "sizes": {
          "type": "array",
          "items": {
            "enum": [
              "2x1",
              "3x1",
              "4x1",
              "2x2",
              "4x2",
              "4x4"
            ]
          },
          "minItems": 1
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          },
          "minItems": 1,
          "maxItems": 16
        }
      },
      "required": [
        "id",
        "name",
        "sizes",
        "blocks"
      ],
      "additionalProperties": false
    }
  }
}
